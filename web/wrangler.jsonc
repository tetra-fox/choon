// `just web-deploy` serves web/dist as a Worker with static assets and no script
{
  "$schema": "https://unpkg.com/wrangler@4.156.0/config-schema.json",
  "name": "choon",
  "account_id": "6e2af1adf2703563e434f0880b4f69b7",
  "compatibility_date": "2026-11-28",
  // the page's one address, a custom domain on the tetra.cool zone, and no workers.dev one
  "routes": [{ "pattern": "choon.tetra.cool", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
  },
}
